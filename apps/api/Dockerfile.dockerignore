# Contexte de build de apps/api/Dockerfile (BuildKit lit ce fichier à la place de .dockerignore) :
# liste blanche, seulement ce que le Dockerfile copie. Jamais de dist/, node_modules/ ni de client
# Prisma généré du poste : tout est reconstruit dans l'image.
*
!package.json
!package-lock.json
!tsconfig.base.json
!apps/api/package.json
!apps/api/tsconfig.build.json
!apps/api/src/
!apps/api/docker/dev-optional.txt
!apps/site/package.json
!libs/shared/tokens/package.json
!libs/shared/schemas/package.json
!libs/shared/schemas/tsconfig.lib.json
!libs/shared/schemas/src/
!libs/api/db/package.json
!libs/api/db/tsconfig.lib.json
!libs/api/db/prisma.config.ts
!libs/api/db/prisma/
!libs/api/db/src/
libs/api/db/src/generated/
!libs/api/db/sql/roles.sql
