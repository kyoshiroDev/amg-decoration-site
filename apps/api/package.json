{
  "name": "@amg/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API des CRM d'AMG Décoration (NestJS 12 sur Fastify, ESM) : admin et espace client (ADR-0019, ADR-0023).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "start": "node --enable-source-maps dist/main.js",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@amg/api-db": "*",
    "@amg/shared-schemas": "*",
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "@nestjs/common": "12.6.2",
    "@nestjs/core": "12.6.2",
    "@nestjs/platform-fastify": "12.6.2",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "@types/pg": "8.23.1",
    "pg": "8.23.1"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/tsconfig.base.json"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "check": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/tsconfig.base.json"
        ]
      },
      "lint": {
        "dependsOn": [
          "^build"
        ]
      },
      "test": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/tsconfig.base.json"
        ]
      },
      "test:integration": {
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
