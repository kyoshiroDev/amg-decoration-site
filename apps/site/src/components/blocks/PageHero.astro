---
/**
 * PageHero — ouverture d'une page interne (sous le fil d'Ariane) : surtitre, h1, chapeau,
 * actions. Avec `image` : composition 7/5 et arche arrondie ; sans image : texte seul et arche
 * filaire terracotta en filigrane (décor).
 */
import type { ImageMetadata } from 'astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import ActionGroup from '@/components/ui/ActionGroup.astro';
import ArchImage from '@/components/ui/ArchImage.astro';
import SectionIntro from './SectionIntro.astro';
import type { PageSection } from '@/lib/pages/types';

interface Props {
  section: PageSection;
  id?: string;
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
  headingLevel?: 1 | 2;
  priority?: boolean;
}

const {
  section,
  id = 'page-titre',
  image,
  imageAlt = '',
  headingLevel = 1,
  priority = true,
} = Astro.props;
---

<Section spacing="compact" labelledby={id} class="page-hero">
  <Container class:list={['page-hero__grid', { 'page-hero__grid--media': image }]}>
    <div class="page-hero__text">
      <SectionIntro
        id={id}
        level={headingLevel}
        size="xl"
        eyebrow={section.eyebrow}
        heading={section.heading}
        emphasis={section.headingEmphasis}
        lead={section.lead}
      />
      <ActionGroup actions={section.actions} />
    </div>
    {image ? (
      <ArchImage
        src={image}
        alt={imageAlt}
        sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 26rem, 90vw"
        widths={[360, 540, 720, 960]}
        priority={priority}
        ratio="3 / 4"
        class="page-hero__image"
      />
    ) : (
      <span class="page-hero__arch" aria-hidden="true" />
    )}
  </Container>
</Section>

<style>
  @layer components {
    :global(.page-hero) {
      overflow-x: clip;
    }

    :global(.page-hero__grid) {
      position: relative;
      display: grid;
      gap: var(--space-xl);
      align-items: end;

      @media (width >= 64rem) {
        grid-template-columns: 7fr 5fr;
        gap: var(--space-3xl);
      }
    }

    .page-hero__text {
      display: grid;
      justify-items: start;
      gap: var(--space-l);
    }

    :global(.page-hero__image) {
      inline-size: min(100%, var(--page-hero-visual-max));
      justify-self: center;
    }

    /* Arche filaire en filigrane : n'occupe aucune place, ne dépasse jamais du conteneur. */
    .page-hero__arch {
      display: none;

      @media (width >= 64rem) {
        display: block;
        justify-self: end;
        inline-size: var(--page-hero-arch-size);
        aspect-ratio: 3 / 4;
        border: var(--border-hairline) solid var(--color-accent);
        border-block-end: 0;
        border-radius: var(--radius-arch);
      }
    }
  }
</style>
