---
// Page d'une prestation (formule ou offre). Chemins et données : getServicePaths()
// (src/lib/pages/services.ts) ; corps : src/content/prestations/<slug>.md.
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/blocks/PageHero.astro';
import ProseLayout from '@/components/blocks/ProseLayout.astro';
import RichText from '@/components/blocks/RichText.astro';
import ServiceFacts from '@/components/blocks/ServiceFacts.astro';
import ServicesGrid from '@/components/blocks/ServicesGrid.astro';
import FurtherReading from '@/components/blocks/FurtherReading.astro';
import CtaBanner from '@/components/blocks/CtaBanner.astro';
import { microcopy } from '@/config/microcopy';
import { getServicePaths, type ServicePageProps } from '@/lib/pages/services';

export const getStaticPaths = getServicePaths;

type Props = ServicePageProps;

const { model, further, jsonLd, Content } = Astro.props;
---

<PageLayout
  title={model.seo.title}
  description={model.seo.description}
  image={model.cover?.image}
  imageAlt={model.cover?.alt}
  breadcrumbs={model.breadcrumbs}
  jsonLd={jsonLd}
>
  <PageHero section={model.hero} id="prestation-titre" />
  <ProseLayout>
    <ServiceFacts slot="aside" facts={model.facts} action={model.factsAction} />
    <RichText>
      <Content />
    </RichText>
  </ProseLayout>
  <FurtherReading
    heading={microcopy.services.further.heading}
    items={further}
    id="plus-loin-titre"
    background="ivory"
  />
  {model.others.length > 0 && (
    <ServicesGrid
      section={model.othersSection}
      services={model.others}
      id="autres-formules-titre"
      background="beige"
    />
  )}
  <CtaBanner section={model.cta} id="contact-titre" />
</PageLayout>
