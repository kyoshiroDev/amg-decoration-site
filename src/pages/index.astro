---
// Accueil PROVISOIRE (Phase 2) : remplacé en Phase 4 par l'assemblage des blocks définitifs.
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProvisionalHero from '@/components/blocks/ProvisionalHero.astro';
import { pageTexts } from '@/config/pages';
import { site } from '@/config/site';
import { seoDefaults } from '@/config/seo';

const { home } = pageTexts;
---

<BaseLayout title={home.title} description={home.description}>
  <ProvisionalHero
    eyebrow={site.founder.name}
    heading={home.heading}
    emphasis={home.headingEmphasis}
    lead={home.lead}
    image={seoDefaults.ogImage}
    imageAlt={seoDefaults.ogImageAlt}
  />
</BaseLayout>
