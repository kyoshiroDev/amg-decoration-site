---
// Accueil PROVISOIRE (Phase 2) : remplacé en Phase 4 par l'assemblage des blocks définitifs.
// Textes : src/content/pages/accueil.md.
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProvisionalHero from '@/components/blocks/ProvisionalHero.astro';
import { site } from '@/config/site';
import { seoDefaults } from '@/config/seo';
import { requireEntry } from '@/lib/content';

const { seo, hero } = requireEntry(await getEntry('pages', 'accueil'), 'pages', 'accueil').data;
---

<BaseLayout title={seo.title} description={seo.description}>
  <ProvisionalHero
    eyebrow={site.founder.name}
    heading={hero.heading}
    emphasis={hero.headingEmphasis}
    lead={hero.lead}
    image={seoDefaults.ogImage}
    imageAlt={seoDefaults.ogImageAlt}
  />
</BaseLayout>
