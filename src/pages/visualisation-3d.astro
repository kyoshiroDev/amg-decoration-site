---
// Visualisation 3D : assemblage des blocs. Données : getMethodData() (src/lib/pages/method.ts),
// textes : src/content/pages/visualisation-3d.md, collections `etapes` et `avantages`.
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/blocks/PageHero.astro';
import MediaText from '@/components/blocks/MediaText.astro';
import BeforeAfter from '@/components/blocks/BeforeAfter.astro';
import ProcessSteps from '@/components/blocks/ProcessSteps.astro';
import Benefits3D from '@/components/blocks/Benefits3D.astro';
import FurtherReading from '@/components/blocks/FurtherReading.astro';
import CtaBanner from '@/components/blocks/CtaBanner.astro';
import { media } from '@/config/media';
import { microcopy } from '@/config/microcopy';
import { getMethodData } from '@/lib/pages/method';
import { requireSiteOrigin } from '@/lib/url';

const data = await getMethodData(requireSiteOrigin(Astro.site));
const { sections } = data;
const compareLabels = microcopy.projects.beforeAfter;
---

<PageLayout
  title={data.seo.title}
  description={data.seo.description}
  image={media.methodHero.image}
  imageAlt={media.methodHero.alt}
  breadcrumbs={data.breadcrumbs}
  jsonLd={data.jsonLd}
>
  <PageHero
    section={data.hero}
    id="visualisation-titre"
    image={media.methodHero.image}
    imageAlt={media.methodHero.alt}
  />
  <MediaText section={sections.promesse} id="promesse-titre" background="ivory" reverse />
  <BeforeAfter
    eyebrow={sections.comparatif.eyebrow}
    heading={sections.comparatif.heading}
    emphasis={sections.comparatif.headingEmphasis}
    lead={sections.comparatif.lead}
    rendering={media.methodCompare.rendering}
    result={media.methodCompare.result}
    labels={compareLabels}
    id="comparatif-titre"
  />
  <ProcessSteps section={sections.methode} steps={data.steps} id="methode-titre" />
  <Benefits3D section={sections.avantages} benefits={data.benefits} id="avantages-titre" />
  <FurtherReading
    heading={sections['plus-loin'].heading}
    items={data.further}
    id="plus-loin-titre"
    background="ivory"
  />
  <CtaBanner section={sections.cta} id="contact-titre" />
</PageLayout>
