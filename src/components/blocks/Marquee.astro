---
/**
 * Marquee — bandeau de mots-clés en Fraunces italique, séparés par de petites arches.
 * STATIQUE dans ce lot (défilement en Phase 5, en pause au survol, coupé si mouvement réduit).
 * Accessibilité : la première liste est lue une fois ; les copies (nécessaires à la boucle
 * du défilement) sont `aria-hidden`.
 */
interface Props {
  words: readonly string[];
  /** Nom accessible de la liste lue. */
  label: string;
  /** Nombre total de copies du mot-clé (≥ 2 pour un défilement sans couture). */
  copies?: number;
}

const { words, label, copies = 2 } = Astro.props;
const duplicates = Array.from({ length: Math.max(0, copies - 1) }, (_, index) => index);
---

<div class="marquee" data-marquee>
  <div class="marquee__track">
    <ul class="marquee__list" aria-label={label}>
      {words.map((word) => (
        <li class="marquee__word">{word}</li>
      ))}
    </ul>
    {duplicates.map(() => (
      <ul class="marquee__list" aria-hidden="true">
        {words.map((word) => (
          <li class="marquee__word">{word}</li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  @layer components {
    .marquee {
      overflow: hidden;
      padding-block: var(--space-m);
      border-block: var(--border-hairline) solid var(--color-border);
    }

    .marquee__track {
      display: flex;
      inline-size: max-content;
    }

    .marquee__list {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      padding: 0;
      margin: 0;
    }

    .marquee__word {
      display: flex;
      align-items: center;
      font-family: var(--font-display-stack);
      font-size: var(--step-3);
      font-style: italic;
      font-weight: var(--weight-light);
      line-height: var(--leading-tight);
      white-space: nowrap;

      /* Petite arche terracotta entre les mots (décor). */
      &::after {
        content: '';
        inline-size: var(--space-s);
        aspect-ratio: 3 / 4;
        margin-inline: var(--space-l);
        border: var(--border-thin) solid var(--color-accent);
        border-block-end: 0;
        border-radius: var(--radius-arch);
      }
    }
  }
</style>
