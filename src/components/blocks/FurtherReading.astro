---
/**
 * FurtherReading — « Pour aller plus loin » : en fin d'article (formule liée, réalisation liée,
 * autre article) et sur les fiches prestations (un article, une réalisation), en cartes crème (1 → 3 colonnes). Titre-lien étendu à la carte,
 * surtitre qui dit la nature du lien, texte court, petite arche filaire en tête.
 * Le surtitre suit le titre dans le DOM (le lecteur d'écran lit d'abord le titre, puis la
 * nature du lien) et remonte visuellement au-dessus (order). Sur section ivoire, les cartes
 * passent en crème, bordées d'un filet : elles se détachent du fond.
 */
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import SectionIntro from './SectionIntro.astro';
import type { FurtherItem } from '@/lib/pages/articles-model';

interface Props {
  heading: string;
  items: readonly FurtherItem[];
  id: string;
  background?: 'cream' | 'ivory' | 'beige' | 'rose' | 'greige';
}

const { heading, items, id, background = 'cream' } = Astro.props;
---

{items.length > 0 && (
  <Section background={background} labelledby={id}>
    <Container class="further-reading">
      <SectionIntro id={id} heading={heading} />
      <ul
        class:list={[
          'further-reading__list',
          { 'further-reading__list--on-surface': background === 'ivory' },
        ]}
      >
        {items.map((item) => (
          <li class="further-reading__card">
            <h3 class="further-reading__title">
              <a class="further-reading__link" href={item.href}>
                {item.title}
              </a>
            </h3>
            <p class="further-reading__eyebrow">{item.eyebrow}</p>
            <p class="further-reading__text">{item.text}</p>
          </li>
        ))}
      </ul>
    </Container>
  </Section>
)}

<style>
  @layer components {
    :global(.further-reading) {
      display: grid;
      gap: var(--space-l-2xl);
    }

    .further-reading__list {
      display: grid;
      gap: var(--space-m);
      margin: 0;

      @media (width >= 64rem) {
        grid-template-columns: repeat(3, 1fr);
        gap: var(--grid-gap);

        /* 2 ou 4 cartes (fiches prestations, page 3D) : deux colonnes, sans carte orpheline. */
        &:has(> :nth-child(2):last-child, > :nth-child(4):last-child) {
          grid-template-columns: repeat(2, 1fr);
        }
      }
    }

    .further-reading__card {
      position: relative;
      display: grid;
      align-content: start;
      gap: var(--space-xs);
      padding: var(--space-l);
      border-radius: var(--radius-lg);
      border: var(--border-hairline) solid var(--color-border);
      background-color: var(--further-card-bg, var(--color-surface));
      box-shadow: var(--shadow-soft);

      &:has(.further-reading__link:focus-visible) {
        outline: var(--focus-ring);
        outline-offset: var(--focus-ring-offset);
      }

      /* Petite arche filaire camel (décor), puis surtitre remonté au-dessus du titre. */
      &::before {
        content: '';
        order: -2;
        inline-size: var(--space-m);
        block-size: var(--space-l);
        margin-block-end: var(--space-2xs);
        border: var(--border-hairline) solid var(--color-accent);
        border-block-end: 0;
        border-radius: var(--radius-arch);
      }
    }

    .further-reading__list--on-surface {
      --further-card-bg: var(--color-bg);
    }

    .further-reading__eyebrow {
      order: -1;
      font-size: var(--text-eyebrow);
      font-weight: var(--weight-semibold);
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--color-accent-text);
    }

    .further-reading__title {
      font-size: var(--step-2);
      line-height: var(--leading-heading);
      text-wrap: balance;
    }

    .further-reading__link {
      color: var(--color-text);
      text-decoration: none;

      &::after {
        content: '';
        position: absolute;
        inset: 0;
      }

      /* Anneau reporté sur la carte entière (:has) ; sans :has, le lien garde le sien. */
      @supports selector(:has(*)) {
        &:focus-visible {
          outline: none;
        }
      }

      &:hover {
        color: var(--color-accent-text);
      }
    }

    .further-reading__text {
      color: var(--color-text-soft);
    }
  }
</style>
