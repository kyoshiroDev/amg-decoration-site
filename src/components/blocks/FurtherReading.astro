---
/**
 * FurtherReading — « Pour aller plus loin » en fin d'article : la formule liée, la réalisation
 * liée et un autre article, en cartes crème (1 → 3 colonnes). Titre-lien étendu à la carte,
 * surtitre qui dit la nature du lien, texte court, petite arche filaire en tête.
 */
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import SectionIntro from './SectionIntro.astro';
import type { FurtherItem } from '@/lib/pages/articles-model';

interface Props {
  heading: string;
  items: readonly FurtherItem[];
  id: string;
  background?: 'linen' | 'cream' | 'sand' | 'blush' | 'sage';
}

const { heading, items, id, background = 'linen' } = Astro.props;
---

{items.length > 0 && (
  <Section background={background} labelledby={id}>
    <Container class="further-reading">
      <SectionIntro id={id} heading={heading} />
      <ul class="further-reading__list">
        {items.map((item) => (
          <li class="further-reading__card">
            <p class="further-reading__eyebrow">{item.eyebrow}</p>
            <h3 class="further-reading__title">
              <a class="further-reading__link" href={item.href}>
                {item.title}
              </a>
            </h3>
            <p class="further-reading__text">{item.text}</p>
          </li>
        ))}
      </ul>
    </Container>
  </Section>
)}

<style>
  @layer components {
    :global(.further-reading) {
      display: grid;
      gap: var(--space-l-2xl);
    }

    .further-reading__list {
      display: grid;
      gap: var(--space-m);
      margin: 0;

      @media (width >= 64rem) {
        grid-template-columns: repeat(3, 1fr);
        gap: var(--grid-gap);
      }
    }

    .further-reading__card {
      position: relative;
      display: grid;
      align-content: start;
      gap: var(--space-xs);
      padding: var(--space-l);
      border-radius: var(--radius-lg);
      background-color: var(--color-surface);
      box-shadow: var(--shadow-soft);

      &:has(.further-reading__link:focus-visible) {
        outline: var(--focus-ring);
        outline-offset: var(--focus-ring-offset);
      }

      /* Petite arche filaire terracotta (décor). */
      &::before {
        content: '';
        inline-size: var(--space-m);
        block-size: var(--space-l);
        margin-block-end: var(--space-2xs);
        border: var(--border-hairline) solid var(--color-accent);
        border-block-end: 0;
        border-radius: var(--radius-arch);
      }
    }

    .further-reading__eyebrow {
      font-size: var(--text-eyebrow);
      font-weight: var(--weight-semibold);
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--color-accent-text);
    }

    .further-reading__title {
      font-size: var(--step-2);
      line-height: var(--leading-heading);
      text-wrap: balance;
    }

    .further-reading__link {
      color: var(--color-text);
      text-decoration: none;

      &::after {
        content: '';
        position: absolute;
        inset: 0;
      }

      &:focus-visible {
        outline: none;
      }

      &:hover {
        color: var(--color-accent-text);
      }
    }

    .further-reading__text {
      color: var(--color-text-soft);
    }
  }
</style>
