---
/**
 * ProjectCard — carte d'une réalisation : visuel (arche ou paysage arrondi), style et lieu,
 * titre-lien (zone cliquable étendue à toute la carte), accroche.
 * Le zoom lent du visuel suit le survol de la carte entière (le lien recouvre l'image).
 * Le visuel porte le même nom de View Transition que la couverture de la page projet.
 */
import ArchImage from '@/components/ui/ArchImage.astro';
import { microcopy } from '@/config/microcopy';
import { PROJECT_TRANSITION_CLASS, projectTransitionName, type ProjectCardData } from '@/lib/cards';

// Carte affichée au moins sur ~90vw (mobile) : même sur un écran de 320 px en densité 2, le navigateur
// demande environ 720 px. Les variantes plus petites ne servaient jamais et allongeaient le HTML de
// l'accueil (budget de 14 Kio). ArchImage les plafonne à la largeur recadrée au ratio de la carte
// (480 px pour une source 1200 × 600 en arche 4/5 : une seule variante).
const CARD_WIDTHS = [720, 960, 1280];

interface Props {
  project: ProjectCardData;
  /** `arch` : portrait 4/5 en arche ; `wide` : paysage 5/4 arrondi. */
  shape?: 'arch' | 'wide';
  /** Attribut `sizes` adapté à la place de la carte dans la grille. */
  sizes: string;
  headingLevel?: 2 | 3;
}

const { project, shape = 'arch', sizes, headingLevel = 3 } = Astro.props;
const Title = `h${headingLevel}` as const;
const meta = [project.style, project.location].filter((part): part is string => Boolean(part));
---

<article class:list={['project-card', `project-card--${shape}`]}>
  <ArchImage
    src={project.image}
    alt={project.alt}
    sizes={sizes}
    widths={CARD_WIDTHS}
    shape={shape === 'arch' ? 'arch' : 'rounded'}
    ratio={shape === 'arch' ? '4 / 5' : '5 / 4'}
    transitionName={projectTransitionName(project.slug)}
    transitionClass={PROJECT_TRANSITION_CLASS}
    class="project-card__media"
  />
  <div class="project-card__body">
    <p class="project-card__meta">{meta.join(' · ')}</p>
    <Title class="project-card__title">
      <a class="project-card__link" href={project.href}>
        {project.title}
      </a>
    </Title>
    <p class="project-card__summary">{project.summary}</p>
    <span class="project-card__more link-draw" aria-hidden="true">
      {microcopy.projects.more}
    </span>
  </div>
</article>

<style>
  @layer components {
    .project-card {
      position: relative;
      display: grid;
      gap: var(--space-m);

      &:has(.project-card__link:focus-visible) {
        outline: var(--focus-ring);
        outline-offset: var(--focus-ring-offset);
        border-radius: var(--radius-md);
      }
    }

    .project-card__body {
      display: grid;
      justify-items: start;
      gap: var(--space-2xs);
    }

    .project-card__meta {
      font-size: var(--text-eyebrow);
      font-weight: var(--weight-semibold);
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--color-accent-text);
    }

    .project-card__title {
      font-size: var(--step-2);
      line-height: var(--leading-heading);
    }

    .project-card--wide .project-card__title {
      font-size: var(--step-3);
      font-weight: var(--weight-light);
    }

    .project-card__link {
      color: var(--color-text);
      text-decoration: none;

      &::after {
        content: '';
        position: absolute;
        inset: 0;
      }

      /* Anneau reporté sur la carte entière (:has) ; sans :has, le lien garde le sien. */
      @supports selector(:has(*)) {
        &:focus-visible {
          outline: none;
        }
      }
    }

    .project-card__summary {
      color: var(--color-text-soft);
    }

    .project-card__more {
      margin-block-start: var(--space-2xs);
      font-size: var(--step--1);
      font-weight: var(--weight-semibold);
      color: var(--color-accent-text);
    }

    /* Survol ou focus clavier de la carte : invitation dessinée et zoom lent du visuel. */
    .project-card:is(:hover, :has(.project-card__link:focus-visible)) {
      & .project-card__more::after {
        transform: scaleX(1);
      }

      & :global(.arch-image__img) {
        transform: scale(var(--hover-zoom));
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .project-card:is(:hover, :has(.project-card__link:focus-visible)) :global(.arch-image__img) {
        transform: none;
      }
    }
  }
</style>
