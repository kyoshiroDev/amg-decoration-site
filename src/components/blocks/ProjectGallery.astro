---
/**
 * ProjectGallery — images d'un projet regroupées par nature (Avant · Rendu 3D · Réalisé).
 * ≥ 64rem : libellé du groupe (h3 Fraunces italique) collant à gauche (3/12), images à droite
 * (9/12) ; la première image d'un groupe impair occupe toute la largeur. Images simples, sans
 * lien (la lightbox arrive en Phase 5).
 */
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import ArchImage from '@/components/ui/ArchImage.astro';
import SectionIntro from './SectionIntro.astro';
import type { GalleryGroup } from '@/lib/pages/projects-model';

interface Props {
  heading: string;
  groups: readonly GalleryGroup[];
  id: string;
  background?: 'linen' | 'cream' | 'sand' | 'blush' | 'sage';
}

const { heading, groups, id, background = 'cream' } = Astro.props;
---

<Section background={background} labelledby={id}>
  <Container class="project-gallery">
    <SectionIntro id={id} heading={heading} />
    {groups.map((group) => (
      <div class="project-gallery__group">
        <h3 class="project-gallery__label">{group.label}</h3>
        <ul class="project-gallery__list">
          {group.items.map((item) => (
            <li class="project-gallery__item">
              <ArchImage
                src={item.image}
                alt={item.alt}
                caption={item.caption}
                shape="rounded"
                ratio="3 / 2"
                sizes="(min-width: 64rem) 60vw, 90vw"
              />
            </li>
          ))}
        </ul>
      </div>
    ))}
  </Container>
</Section>

<style>
  @layer components {
    :global(.project-gallery) {
      display: grid;
      gap: var(--space-l-2xl);
    }

    .project-gallery__group {
      display: grid;
      gap: var(--space-m);

      @media (width >= 64rem) {
        grid-template-columns: 3fr 9fr;
        gap: var(--grid-gap);
        align-items: start;
      }
    }

    .project-gallery__label {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      font-family: var(--font-display-stack);
      font-size: var(--step-3);
      font-style: italic;
      font-weight: var(--weight-light);
      line-height: var(--leading-heading);
      color: var(--color-accent-text);

      @media (width >= 64rem) {
        position: sticky;
        inset-block-start: calc(var(--header-height) + var(--space-m));
      }

      /* Petite arche filaire terracotta (décor). */
      &::before {
        content: '';
        flex: none;
        inline-size: var(--space-s);
        block-size: var(--space-m);
        border: var(--border-hairline) solid var(--color-accent);
        border-block-end: 0;
        border-radius: var(--radius-arch);
      }
    }

    .project-gallery__list {
      display: grid;
      gap: var(--space-m);
      margin: 0;

      @media (width >= 48rem) {
        grid-template-columns: repeat(2, 1fr);
        gap: var(--grid-gap);
      }
    }

    @media (width >= 48rem) {
      .project-gallery__item:first-child:nth-last-child(odd) {
        grid-column: 1 / -1;
      }
    }
  }
</style>
