---
/**
 * Hero — ouverture de l'accueil : composition 7/5, surtitre, titre (h1) avec fragment en
 * italique, chapeau, actions (principale, secondaire) ; arche avec liseré décalé et soleil grège.
 * Seule image `priority` de la page. Dans le styleguide : `headingLevel={2}` et `priority={false}`.
 */
import type { ImageMetadata } from 'astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import Emphasis from '@/components/ui/Emphasis.astro';
import ActionGroup from '@/components/ui/ActionGroup.astro';
import ArchImage from '@/components/ui/ArchImage.astro';
import type { PageSection } from '@/lib/pages/types';

interface Props {
  section: PageSection;
  eyebrow?: string | undefined;
  image: ImageMetadata;
  imageAlt: string;
  id?: string;
  headingLevel?: 1 | 2;
  priority?: boolean;
}

const {
  section,
  eyebrow = section.eyebrow,
  image,
  imageAlt,
  id = 'accueil-titre',
  headingLevel = 1,
  priority = true,
} = Astro.props;
---

<Section spacing="compact" labelledby={id} class="hero">
  <Container class="hero__grid">
    <div class="hero__text" data-reveal>
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <Heading level={headingLevel} size="xl" id={id} class="hero__title">
        <Emphasis text={section.heading} emphasis={section.headingEmphasis} />
      </Heading>
      {section.lead && <p class="hero__lead">{section.lead}</p>}
      <ActionGroup actions={section.actions} magnetic class="hero__actions" />
    </div>
    <div class="hero__visual">
      <span class="hero__sun" aria-hidden="true"></span>
      <ArchImage
        src={image}
        alt={imageAlt}
        sizes="(min-width: 80rem) 30rem, (min-width: 64rem) 38vw, (min-width: 40rem) 29rem, 88vw"
        widths={[360, 540, 720, 960]}
        priority={priority}
        framed
      />
    </div>
  </Container>
</Section>

<style>
  @layer components {
    /* Le soleil déborde de l'arche : jamais de défilement horizontal. */
    :global(.hero) {
      overflow-x: clip;
    }

    :global(.hero__grid) {
      display: grid;
      gap: var(--space-2xl);
      align-items: center;

      @media (width >= 64rem) {
        grid-template-columns: 7fr 5fr;
        gap: var(--space-3xl);
      }
    }

    .hero__text {
      display: grid;
      justify-items: start;
      gap: var(--space-m);
    }

    /* Titre long (phrase complète) : un cran sous --step-5, mesure de lecture courte. */
    :global(.hero__title) {
      max-inline-size: var(--measure-title);
    }

    .hero__lead {
      font-size: var(--step-1);
      color: var(--color-text-soft);
    }

    :global(.hero__actions) {
      margin-block-start: var(--space-xs);
    }

    .hero__visual {
      position: relative;
      inline-size: min(100%, var(--hero-visual-max));
      justify-self: center;

      @media (width >= 64rem) {
        justify-self: end;
      }
    }

    /* Soleil grège qui « pose » l'arche (décor, derrière l'image). */
    .hero__sun {
      position: absolute;
      inset-block-end: calc(var(--space-l) * -1);
      inset-inline-start: calc(var(--space-l) * -1);
      inline-size: 42%;
      aspect-ratio: 1;
      border-radius: var(--radius-pill);
      background-color: var(--color-greige);
    }
  }
</style>
