---
/**
 * ContactLayout — page Contact : formulaire (slot par défaut, 7/12) et coordonnées (slot
 * `aside`, 5/12, collantes sous l'en-tête si la fenêtre est assez haute) à partir de 64rem ;
 * empilés sur mobile, formulaire d'abord. Le formulaire est posé sur une carte crème.
 */
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
---

<Section as="div" spacing="compact" class="contact-layout">
  <Container class="contact-layout__grid">
    <div class="contact-layout__main">
      <slot />
    </div>
    <div class="contact-layout__aside">
      <slot name="aside" />
    </div>
  </Container>
</Section>

<style>
  @layer components {
    :global(.contact-layout__grid) {
      display: grid;
      gap: var(--space-l-2xl);
      align-items: start;

      @media (width >= 64rem) {
        grid-template-columns: 7fr 5fr;
        gap: var(--space-2xl);
      }
    }

    .contact-layout__main {
      padding: var(--space-l) var(--space-m);
      border-radius: var(--radius-lg);
      background-color: var(--color-surface);
      box-shadow: var(--shadow-soft);

      @media (width >= 48rem) {
        padding: var(--space-xl) var(--space-xl);
      }
    }

    /*
     * Coordonnées collantes seulement si la fenêtre est assez haute pour montrer la carte en
     * entier sous l'en-tête compact. Carte compacte mesurée (ContactDetails) : ~47rem dès 75rem
     * de large (libellé et valeur sur une ligne), ~57rem entre 64 et 75rem (colonne étroite,
     * rubriques empilées). Plus bas (portable 1280 × 800, zoom), elle reste dans le flux : rien
     * n'est rogné, un lien focalisé au clavier défile à l'écran comme le reste de la page
     * (WCAG 2.4.7, 2.4.11). Pas de défilement interne. Seuils en rem : ils suivent la taille de
     * police choisie par le visiteur.
     */
    .contact-layout__aside {
      @media (width >= 64rem) and (height >= 64rem), (width >= 75rem) and (height >= 53rem) {
        position: sticky;
        inset-block-start: calc(var(--header-height-compact) + var(--space-s));
      }
    }
  }
</style>
