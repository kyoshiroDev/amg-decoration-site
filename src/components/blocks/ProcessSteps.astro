---
/**
 * ProcessSteps — méthode en étapes (liste ordonnée) : numéro en Fraunces italique géante
 * semi-transparente au-dessus du titre (décor, aria-hidden : l'ordre est porté par <ol>),
 * titre, texte.
 * 1 colonne → 2 (≥ 48rem) → 3 (≥ 64rem), colonne centrale décalée vers le bas.
 * `variant="summary"` (accueil) : titres seuls, le détail vit sur /visualisation-3d/ (pas de
 * contenu dupliqué entre les deux pages).
 */
import ContentSection from './ContentSection.astro';
import Heading from '@/components/ui/Heading.astro';
import { formatStepNumber, type TextItemData } from '@/lib/cards';
import type { PageSection } from '@/lib/pages/types';

interface Props {
  section: PageSection;
  steps: readonly TextItemData[];
  id: string;
  background?: 'cream' | 'ivory' | 'beige' | 'rose' | 'greige';
  /** `full` : titre et texte ; `summary` : titres seuls. */
  variant?: 'full' | 'summary';
}

const { section, steps, id, background = 'greige', variant = 'full' } = Astro.props;
---

<ContentSection section={section} id={id} background={background}>
  <ol class:list={['process-steps', `process-steps--${variant}`]} data-reveal="list">
    {steps.map((step, index) => (
      <li class="process-steps__item">
        <span class="process-steps__number" aria-hidden="true">
          {formatStepNumber(index)}
        </span>
        {/* Résumé : intitulés en <p>, pas 6 h3 vides ; la liste ordonnée porte la structure. */}
        <Heading
          level={3}
          size="md"
          class="process-steps__title"
          as={variant === 'summary' ? 'p' : undefined}
        >
          {step.title}
        </Heading>
        {variant === 'full' && <p class="process-steps__text">{step.text}</p>}
      </li>
    ))}
  </ol>
</ContentSection>

<style>
  @layer components {
    .process-steps {
      display: grid;
      gap: var(--space-xl) var(--grid-gap);
      padding: 0;
      margin: 0;

      /* --reveal-columns / --reveal-shift : cascade d'apparition par colonne (motion.css). */
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, 1fr);

        --reveal-columns: 2;
      }

      @media (width >= 64rem) {
        grid-template-columns: repeat(3, 1fr);

        --reveal-columns: 3;
      }
    }

    @media (width >= 64rem) {
      .process-steps__item:nth-child(3n + 2) {
        margin-block-start: var(--grid-stagger);

        --reveal-shift: var(--grid-stagger);
      }
    }

    .process-steps__item {
      position: relative;
      display: grid;
      align-content: start;
      gap: var(--space-xs);
      padding-block-start: var(--space-s);
      border-block-start: var(--border-hairline) solid var(--color-border-strong);
    }

    /*
     * Numéro géant au-dessus du titre, sans chevauchement : un titre qui le recouvrait le
     * faisait paraître tronqué (le bas des chiffres disparaissait sous la première ligne).
     * Interligne serré : la boîte épouse les chiffres, l'écart avec le titre vient du `gap`.
     */
    .process-steps__number {
      font-family: var(--font-display-stack);
      font-size: var(--step-5);
      font-style: italic;
      font-weight: var(--weight-light);
      line-height: var(--leading-tight);
      color: var(--color-accent);
      opacity: var(--opacity-ornament);
    }

    .process-steps__text {
      color: var(--color-text);
    }

    .process-steps--summary {
      row-gap: var(--space-l);
    }

    /* Mobile, titres seuls : numéro devant le titre, sur sa ligne de base (sous-grille : les
       titres s'alignent sur le numéro le plus large), la liste de six reste courte. */
    @media (width < 48rem) {
      .process-steps--summary {
        grid-template-columns: auto 1fr;
      }

      .process-steps--summary .process-steps__item {
        grid-column: 1 / -1;
        grid-template-columns: subgrid;
        align-items: baseline;
      }
    }

    /* Sans texte, l'élément est à peine plus haut que le décalage complet : la colonne
       centrale semblerait flotter entre deux rangées. Demi-décalage, le zigzag reste lisible. */
    @media (width >= 64rem) {
      .process-steps--summary .process-steps__item:nth-child(3n + 2) {
        margin-block-start: calc(var(--grid-stagger) / 2);

        --reveal-shift: calc(var(--grid-stagger) / 2);
      }
    }
  }
</style>
