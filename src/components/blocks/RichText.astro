---
/**
 * RichText — habillage typographique d'un corps Markdown rendu (`<Content />` de
 * `render(entry)`) : intertitres Fraunces, listes à tirets terracotta, citations, liens
 * soulignés, images arrondies. Mesure de lecture de 66 caractères.
 */
interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
---

<div class:list={['rich-text', className]}>
  <slot />
</div>

<style>
  @layer components {
    .rich-text {
      max-inline-size: var(--measure);
    }

    .rich-text > :global(* + *) {
      margin-block-start: var(--space-s);
    }

    .rich-text > :global(:is(h2, h3, h4)) {
      margin-block-start: var(--space-xl);
    }

    .rich-text > :global(:is(h2, h3, h4) + *) {
      margin-block-start: var(--space-xs);
    }

    .rich-text :global(h2) {
      font-size: var(--step-3);
      font-weight: var(--weight-light);
    }

    .rich-text :global(h3) {
      font-size: var(--step-2);
    }

    .rich-text :global(h4) {
      font-size: var(--step-1);
    }

    .rich-text :global(:is(ul, ol)) {
      display: grid;
      gap: var(--space-2xs);
      padding-inline-start: var(--space-m);
    }

    .rich-text :global(ul > li::marker) {
      content: '—\00a0';
      color: var(--color-accent);
    }

    .rich-text :global(ol > li::marker) {
      font-family: var(--font-display-stack);
      font-style: italic;
      color: var(--color-accent-text);
    }

    .rich-text :global(blockquote) {
      padding-inline-start: var(--space-m);
      border-inline-start: var(--border-thin) solid var(--color-accent);
      font-family: var(--font-display-stack);
      font-size: var(--step-1);
      font-style: italic;
      font-weight: var(--weight-light);
    }

    .rich-text :global(img) {
      border-radius: var(--radius-lg);
    }

    .rich-text :global(hr) {
      margin-block: var(--space-xl);
    }
  }
</style>
