---
/**
 * ProseLayout — corps de page long (Markdown) accompagné d'une colonne latérale : sommaire des
 * pages légales, carte « En bref » d'une prestation. Mobile : la colonne précède le texte ;
 * ≥ 64rem : texte à gauche, colonne à droite, collante sous l'en-tête si l'écran est assez
 * haut. Aucun titre propre : le corps Markdown porte ses h2.
 */
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';

interface Props {
  background?: 'cream' | 'ivory' | 'beige' | 'rose' | 'greige';
  /** Mesure du texte : `body` (66ch) ou `legal` (68ch, lecture longue). */
  measure?: 'body' | 'legal';
}

const { background = 'ivory', measure = 'body' } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<Section background={background} as="div" spacing="compact" class="prose-layout">
  <Container
    class:list={[
      'prose-layout__grid',
      `prose-layout__grid--${measure}`,
      { 'prose-layout__grid--aside': hasAside },
    ]}
  >
    {hasAside && (
      <div class="prose-layout__aside">
        <slot name="aside" />
      </div>
    )}
    <div class="prose-layout__body">
      <slot />
    </div>
  </Container>
</Section>

<style>
  @layer components {
    /* minmax(0, 1fr) : une URL longue ne peut pas élargir la colonne au-delà de l'écran. */
    :global(.prose-layout__grid) {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
      align-items: start;
    }

    :global(.prose-layout__grid--legal .rich-text) {
      max-inline-size: var(--measure-legal);
    }

    @media (width >= 64rem) {
      :global(.prose-layout__grid--aside) {
        grid-template-columns: minmax(0, 1fr) var(--aside-width);
        gap: var(--space-3xl);
      }

      :global(.prose-layout__grid--aside) > .prose-layout__aside {
        grid-column: 2;
        grid-row: 1;
      }

      /*
       * Collante seulement sur un écran assez haut (≥ 50rem) : plus bas (portable 1280 × 800,
       * zoom), la colonne reste dans le flux plutôt que de devenir une petite boîte défilante.
       * Au-dessus, défilement interne en dernier recours, pour un contenu de longueur non
       * bornée (sommaire des CGS) : sans lui, sa fin resterait hors écran pendant toute la
       * lecture et un lien focalisé au clavier y serait invisible (WCAG 2.4.7, 2.4.11). Marge
       * négative compensée par un retrait : position du contenu inchangée, l'ombre portée et
       * l'anneau de focus ne sont pas rognés par le défilement.
       */
      @media (height >= 50rem) {
        :global(.prose-layout__grid--aside) > .prose-layout__aside {
          position: sticky;
          inset-block-start: var(--header-height-compact);
          max-block-size: calc(100dvh - var(--header-height-compact));
          padding: var(--space-m);
          margin: calc(var(--space-m) * -1);
          overflow-y: auto;
          scroll-padding-block: var(--space-m);
        }
      }

      :global(.prose-layout__grid--aside) > .prose-layout__body {
        grid-column: 1;
        grid-row: 1;
      }
    }
  }
</style>
