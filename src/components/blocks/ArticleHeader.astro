---
/**
 * ArticleHeader — ouverture d'un article (sous le fil d'Ariane) : surtitre, h1 centré sur la
 * mesure de lecture, dates et temps de lecture (ArticleMeta), thèmes ; puis la couverture en
 * grand format arrondi, seule image `priority` de la page.
 */
import type { ImageMetadata } from 'astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import ArchImage from '@/components/ui/ArchImage.astro';
import Tag from '@/components/ui/Tag.astro';
import SectionIntro from './SectionIntro.astro';
import ArticleMeta from './ArticleMeta.astro';
import type { DateDisplay } from '@/lib/pages/articles-model';

interface Props {
  eyebrow: string;
  title: string;
  published: DateDisplay;
  updated: DateDisplay | undefined;
  readingTime: string;
  tags: readonly string[];
  labels: { readonly published: string; readonly updated: string; readonly tags: string };
  image: ImageMetadata;
  imageAlt: string;
  id?: string;
}

const {
  eyebrow,
  title,
  published,
  updated,
  readingTime,
  tags,
  labels,
  image,
  imageAlt,
  id = 'article-titre',
} = Astro.props;
---

<Section spacing="compact" labelledby={id} class="article-header">
  <Container class="article-header__inner">
    <div class="article-header__text">
      <SectionIntro id={id} level={1} size="xl" align="center" eyebrow={eyebrow} heading={title} />
      <ArticleMeta
        class="article-header__meta"
        published={published}
        updated={updated}
        readingTime={readingTime}
        labels={labels}
      />
      {tags.length > 0 && (
        <ul class="article-header__tags" aria-label={labels.tags}>
          {tags.map((tag) => (
            <li>
              <Tag tone="outline">{tag}</Tag>
            </li>
          ))}
        </ul>
      )}
    </div>
    <ArchImage
      src={image}
      alt={imageAlt}
      shape="rounded"
      ratio="16 / 9"
      priority
      sizes="(min-width: 82.5rem) 82.5rem, 92vw"
      widths={[540, 720, 960, 1280]}
      class="article-header__image"
    />
  </Container>
</Section>

<style>
  @layer components {
    :global(.article-header__inner) {
      display: grid;
      gap: var(--space-xl);
    }

    .article-header__text {
      display: grid;
      justify-items: center;
      gap: var(--space-m);
      text-align: center;
    }

    :global(.article-header__meta) {
      justify-content: center;
    }

    .article-header__tags {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-2xs);
    }
  }
</style>
