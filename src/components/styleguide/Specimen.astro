---
/**
 * Specimen — cartouche du styleguide : un libellé technique + l'échantillon.
 * Outil interne (page /styleguide/), jamais utilisé sur le site public.
 */
interface Props {
  label: string;
  /** Fond de l'échantillon. */
  surface?: 'none' | 'ivory' | 'cream' | 'beige' | 'rose' | 'greige';
  class?: string | undefined;
}

const { label, surface = 'none', class: className } = Astro.props;
---

<div class:list={['specimen', className]}>
  <p class="specimen__label">
    <code>{label}</code>
  </p>
  <div class:list={['specimen__body', `specimen__body--${surface}`]}>
    <slot />
  </div>
</div>

<style>
  @layer components {
    .specimen {
      display: grid;
      gap: var(--space-2xs);
      align-content: start;
    }

    .specimen__label {
      font-size: var(--step--1);
      color: var(--color-text-soft);
    }

    .specimen__body {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-s);
    }

    .specimen__body:not(.specimen__body--none) {
      padding: var(--space-m);
      border-radius: var(--radius-md);
    }

    .specimen__body--ivory {
      background-color: var(--color-ivory);
    }

    .specimen__body--cream {
      background-color: var(--color-cream);
    }

    .specimen__body--beige {
      background-color: var(--color-beige);
    }

    .specimen__body--rose {
      background-color: var(--color-rose-100);
    }

    .specimen__body--greige {
      background-color: var(--color-greige);
    }
  }
</style>
