---
/**
 * SgIntro — ouverture du styleguide : composition éditoriale asymétrique (7/5) avec arche.
 */
import type { ImageMetadata } from 'astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import Button from '@/components/ui/Button.astro';
import ArchImage from '@/components/ui/ArchImage.astro';
import type { NavItem } from '@/config/site';
import { splitEmphasis } from '@/lib/format';

interface Props {
  image: ImageMetadata;
  eyebrow?: string | undefined;
  heading: string;
  /** Fragment de `heading` en italique. */
  emphasis?: string | undefined;
  lead?: string | undefined;
  /** Action principale puis secondaire. */
  actions: readonly NavItem[];
}

const { image, eyebrow, heading, emphasis, lead, actions } = Astro.props;
const title = splitEmphasis(heading, emphasis);
---

<Section labelledby="sg-titre">
  <Container class="sg-intro__grid">
    <div class="sg-intro__text">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <Heading level={1} id="sg-titre">
        {title.before}
        {title.emphasis && <em>{title.emphasis}</em>}
        {title.after}
      </Heading>
      {lead && <p class="sg-intro__lead">{lead}</p>}
      <div class="sg-intro__actions">
        {actions.map((action, index) => (
          <Button
            href={action.href}
            variant={index === 0 ? 'primary' : 'secondary'}
            icon={index === 0 ? 'arrow-right' : undefined}
          >
            {action.label}
          </Button>
        ))}
      </div>
    </div>
    <ArchImage
      src={image}
      alt="Illustration abstraite : un intérieur baigné de lumière, une assise terracotta et une plante sauge."
      sizes="(min-width: 64rem) 34vw, (min-width: 40rem) 60vw, 90vw"
      priority
      framed
      class="sg-intro__image"
    />
  </Container>
</Section>

<style>
  @layer components {
    :global(.sg-intro__grid) {
      display: grid;
      gap: var(--space-xl);
      align-items: center;

      @media (width >= 64rem) {
        grid-template-columns: 7fr 5fr;
        gap: var(--space-2xl);
      }
    }

    .sg-intro__text {
      display: grid;
      justify-items: start;
      gap: var(--space-m);
    }

    .sg-intro__lead {
      font-size: var(--step-1);
      color: var(--color-text-soft);
    }

    .sg-intro__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-s);
      margin-block-start: var(--space-xs);
    }

    :global(.sg-intro__image) {
      inline-size: min(100%, 26rem);
      justify-self: center;

      @media (width >= 64rem) {
        inline-size: auto;
        justify-self: stretch;
      }
    }
  }
</style>
