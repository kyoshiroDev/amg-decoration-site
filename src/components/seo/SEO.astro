---
/**
 * SEO — balises <head> d'une page : titre, description, robots, canonical, Open Graph, Twitter.
 * Les règles de longueur (CLAUDE.md §5) sont vérifiées au build : une violation fait échouer `astro build`.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { seoDefaults } from '@/config/seo';
import { site } from '@/config/site';
import {
  assertDescriptionLength,
  buildArticleMetaTags,
  buildCanonicalUrl,
  buildPageTitle,
  buildRobots,
  pickOgImage,
  type OpenGraphArticle,
} from '@/lib/seo';
import { absoluteUrl, requireSiteOrigin } from '@/lib/url';

interface Props {
  title: string;
  description: string;
  /** Image candidate ; remplacée par l'image par défaut si elle est plus petite que 1200 × 630. */
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
  noindex?: boolean;
  titleSuffix?: boolean;
  /** Article de blog : `og:type` passe à `article` et ajoute les balises `article:*`. */
  article?: OpenGraphArticle | undefined;
}

const {
  title,
  description,
  image,
  imageAlt = seoDefaults.ogImageAlt,
  noindex = false,
  titleSuffix = true,
  article,
} = Astro.props;

const origin = requireSiteOrigin(Astro.site);
const fullTitle = buildPageTitle(
  title,
  {
    suffix: seoDefaults.titleSuffix,
    separator: seoDefaults.titleSeparator,
    maxLength: seoDefaults.titleMaxLength,
  },
  titleSuffix,
);
const metaDescription = assertDescriptionLength(description, seoDefaults.descriptionLength);
const ogType = article ? 'article' : 'website';
const articleTags = article ? buildArticleMetaTags(article) : [];
const canonical = noindex ? undefined : buildCanonicalUrl(Astro.url.pathname, origin);
const { width, height } = seoDefaults.ogImageSize;
// sharp n'agrandit jamais : une candidate plus petite que 1200 × 630 cède la place à l'image par
// défaut (et à son alt) ; une image par défaut trop petite fait échouer le build.
const og = pickOgImage(
  image ? { source: image, alt: imageAlt } : undefined,
  { source: seoDefaults.ogImage, alt: seoDefaults.ogImageAlt },
  seoDefaults.ogImageSize,
);
// Recadrage centré au format 1200 × 630 ; JPEG : format le plus largement accepté par les
// aperçus de liens (Facebook, LinkedIn, WhatsApp…).
const ogImage = await getImage({ src: og.source, width, height, fit: 'cover', format: 'jpg' });
const ogImageUrl = absoluteUrl(ogImage.src, origin);
---

<title>{fullTitle}</title>
<meta name="description" content={metaDescription} />
<meta name="robots" content={buildRobots(noindex)} />
{canonical && <link rel="canonical" href={canonical} />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={seoDefaults.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDescription} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content={String(width)} />
<meta property="og:image:height" content={String(height)} />
<meta property="og:image:alt" content={og.alt} />
{articleTags.map((tag) => (
  <meta property={tag.property} content={tag.content} />
))}

<meta name="twitter:card" content={seoDefaults.twitterCard} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={og.alt} />
