---
/**
 * ArchImage — image en arche (signature visuelle), via <Picture> AVIF + WebP.
 * `alt` est obligatoire (chaîne vide pour une image décorative).
 * `priority` : image héro (loading="eager", fetchpriority="high", decoding="sync").
 * Zoom lent au survol (transform uniquement, désactivé si mouvement réduit).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

type Shape = 'arch' | 'rounded';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Largeurs générées (px). */
  widths?: number[];
  /** Attribut sizes ; à adapter à la mise en page réelle. */
  sizes?: string;
  priority?: boolean;
  /** Ratio CSS du cadre, ex. « 4 / 5 ». */
  ratio?: string;
  shape?: Shape;
  /** Liseré terracotta décalé derrière l'arche. */
  framed?: boolean;
  /** Légende visible (rend un <figure>). */
  caption?: string | undefined;
  class?: string | undefined;
}

const {
  src,
  alt,
  widths = [360, 540, 720, 960, 1280],
  sizes = '(min-width: 64rem) 40vw, 100vw',
  priority = false,
  ratio = '4 / 5',
  shape = 'arch',
  framed = false,
  caption,
  class: className,
} = Astro.props;

const Element = caption ? 'figure' : 'div';
---

<Element
  class:list={['arch-image', `arch-image--${shape}`, { 'arch-image--framed': framed }, className]}
  style={`--arch-ratio: ${ratio}`}
>
  <div class="arch-image__frame">
    <Picture
      src={src}
      alt={alt}
      widths={widths.filter((w) => w <= src.width)}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      priority={priority}
      class="arch-image__img"
    />
  </div>
  {caption && <figcaption class="arch-image__caption">{caption}</figcaption>}
</Element>

<style>
  @layer components {
    .arch-image {
      position: relative;
      margin: 0;
    }

    .arch-image__frame {
      position: relative;
      aspect-ratio: var(--arch-ratio);
      overflow: hidden;
      background-color: var(--color-sand);
      isolation: isolate;
    }

    .arch-image--arch .arch-image__frame {
      border-radius: var(--radius-arch);
    }

    .arch-image--rounded .arch-image__frame {
      border-radius: var(--radius-lg);
    }

    /* Le liseré déborde en haut à droite : on lui réserve la place (pas de chevauchement). */
    .arch-image--framed {
      margin-block-start: var(--space-s);
      margin-inline-end: var(--space-s);
    }

    .arch-image--framed::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      aspect-ratio: var(--arch-ratio);
      border: var(--border-hairline) solid var(--color-accent);
      border-radius: var(--radius-arch);
      transform: translate(var(--space-s), calc(var(--space-s) * -1));
      pointer-events: none;
    }

    .arch-image--framed.arch-image--rounded::before {
      border-radius: var(--radius-lg);
    }

    .arch-image__frame :global(picture),
    .arch-image__frame :global(img) {
      inline-size: 100%;
      block-size: 100%;
    }

    .arch-image__frame :global(img) {
      object-fit: cover;
      transition: transform var(--dur-slow) var(--ease-out);
    }

    .arch-image:hover .arch-image__frame :global(img) {
      transform: scale(var(--hover-zoom));
    }

    .arch-image__caption {
      margin-block-start: var(--space-xs);
      font-size: var(--step--1);
      color: var(--color-text-soft);
    }

    @media (prefers-reduced-motion: reduce) {
      .arch-image:hover .arch-image__frame :global(img) {
        transform: none;
      }
    }
  }
</style>
