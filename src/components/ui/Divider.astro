---
/**
 * Divider — ornement décoratif court : trait fin terracotta (largeur `--space-2xl`), ou double
 * arche encadrée de deux traits courts. Jamais de filet pleine largeur (DESIGN-SYSTEM § 4 :
 * pas de longs traits horizontaux, la séparation vient de l'espace et des aplats).
 * Purement décoratif (aria-hidden) : ne pas l'utiliser pour structurer le contenu.
 */
interface Props {
  ornament?: boolean;
  class?: string | undefined;
}

const { ornament = false, class: className } = Astro.props;
---

<div class:list={['divider', { 'divider--ornament': ornament }, className]} aria-hidden="true">
  {ornament && (
    <svg
      class="divider__arch"
      viewBox="0 0 24 28"
      width="24"
      height="28"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M2 27V12a10 10 0 0 1 20 0v15"
        fill="none"
        stroke="currentColor"
        stroke-width="1.25"
      />
      <path d="M8 27V14.5a4 4 0 0 1 8 0V27" fill="none" stroke="currentColor" stroke-width="1.25" />
    </svg>
  )}
</div>

<style>
  @layer components {
    .divider {
      display: flex;
      align-items: center;
      gap: var(--space-s);
      inline-size: var(--space-2xl);
      color: var(--color-accent);
    }

    .divider::before,
    .divider--ornament::after {
      content: '';
      flex: 1;
      block-size: var(--border-hairline);
      background-color: currentcolor;
    }

    .divider--ornament {
      inline-size: calc(var(--space-2xl) * 2);
    }

    .divider__arch {
      inline-size: var(--space-m);
      block-size: auto;
    }
  }
</style>
