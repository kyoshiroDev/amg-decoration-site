---
/**
 * Heading — titre sémantique.
 * `level` fixe la balise (h1–h6, hiérarchie sans saut) ; `size` fixe la taille visuelle,
 * indépendamment. `as="p"` : même apparence sans balise de titre (intitulé sans contenu
 * dessous, qui encombrerait la navigation par titres). Mettre en <em> les mots émotionnels : ils passent en italique camel.
 */
type Level = 1 | 2 | 3 | 4 | 5 | 6;
type Size = 'display' | 'xl' | 'lg' | 'md' | 'sm' | 'xs';

interface Props {
  level: Level;
  /** Taille visuelle ; par défaut celle du niveau. */
  size?: Size | undefined;
  id?: string | undefined;
  align?: 'start' | 'center';
  class?: string | undefined;
  /** Rendu en <p> (apparence de titre, sans sémantique de titre). */
  as?: 'p' | undefined;
}

const defaultSize: Record<Level, Size> = {
  1: 'display',
  2: 'xl',
  3: 'md',
  4: 'sm',
  5: 'xs',
  6: 'xs',
};

const { level, size, id, align = 'start', class: className, as } = Astro.props;
const Tag = as ?? (`h${level}` as const);
const visualSize = size ?? defaultSize[level];
---

<Tag
  id={id}
  class:list={[
    'heading',
    `heading--${visualSize}`,
    { 'heading--center': align === 'center' },
    className,
  ]}
>
  <slot />
</Tag>

<style>
  @layer components {
    .heading {
      font-family: var(--font-display-stack);
      letter-spacing: var(--tracking-display);
      text-wrap: balance;
    }

    .heading--display {
      font-size: var(--step-5);
      font-weight: var(--weight-light);
      line-height: var(--leading-tight);
    }

    .heading--xl {
      font-size: var(--step-4);
      font-weight: var(--weight-light);
      line-height: var(--leading-tight);
    }

    .heading--lg {
      font-size: var(--step-3);
      font-weight: var(--weight-regular);
      line-height: var(--leading-heading);
    }

    .heading--md {
      font-size: var(--step-2);
      font-weight: var(--weight-regular);
      line-height: var(--leading-heading);
    }

    .heading--sm {
      font-size: var(--step-1);
      font-weight: var(--weight-regular);
      line-height: var(--leading-heading);
    }

    .heading--xs {
      font-family: var(--font-body-stack);
      font-size: var(--step-0);
      font-weight: var(--weight-semibold);
      line-height: var(--leading-heading);
      letter-spacing: 0;
    }

    .heading--center {
      text-align: center;
      margin-inline: auto;
    }
  }
</style>
