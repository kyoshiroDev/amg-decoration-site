---
/**
 * StyleguideLayout — layout minimal TEMPORAIRE pour /styleguide/ (Phase 1).
 * Remplacé par BaseLayout (SEO complet) en Phase 2. Toujours noindex.
 */
import { Font } from 'astro:assets';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Référence interne du design system.' } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font
      cssVariable="--font-display"
      preload={[{ subset: 'latin', style: 'normal', weight: 300 }]}
    />
    <Font cssVariable="--font-body" />
  </head>
  <body>
    <slot />
  </body>
</html>
