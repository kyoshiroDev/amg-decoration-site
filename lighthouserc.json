{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile"
      },
      "maxAutodiscoverUrls": 0,
      "staticDirFileDiscoveryDepth": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/(styleguide/|404|merci/)).*$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2000,
                "aggregationMethod": "median"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05,
                "aggregationMethod": "median"
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 30720
              }
            ],
            "resource-summary:stylesheet:size": [
              "error",
              {
                "maxNumericValue": 35840
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/merci/.*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2000,
                "aggregationMethod": "median"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05,
                "aggregationMethod": "median"
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 30720
              }
            ],
            "resource-summary:stylesheet:size": [
              "error",
              {
                "maxNumericValue": 35840
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/styleguide/.*",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ],
            "largest-contentful-paint": [
              "warn",
              {
                "maxNumericValue": 2500,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/404(\\.html|/).*$",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
