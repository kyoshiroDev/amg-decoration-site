{
  "name": "amg-decoration",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo AMG Décoration d'Intérieur : site vitrine (apps/site), puis CRM admin, espace client et API (ADR-0019).",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @amg/site --",
    "build": "npm run build -w @amg/site --",
    "preview": "npm run preview -w @amg/site --",
    "astro": "npm run astro -w @amg/site --",
    "check": "npm run check -w @amg/site",
    "check:prod": "npm run check:prod -w @amg/site",
    "lint": "npm run lint -w @amg/site && npm run lint:workspace",
    "lint:workspace": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test -w @amg/site --",
    "test:watch": "npm run test:watch -w @amg/site --",
    "test:e2e": "npm run test:e2e -w @amg/site --",
    "test:e2e:service": "npm run test:e2e:service -w @amg/site --",
    "test:visual": "npm run test:visual -w @amg/site --",
    "test:visual:update": "npm run test:visual:update -w @amg/site --",
    "lhci": "npm run lhci -w @amg/site --",
    "verify": "npm run check && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.14.0",
    "postcss-html": "^2.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "stylelint": "^18.0.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
