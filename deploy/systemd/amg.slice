# Plafond de ressources de TOUS les conteneurs AMG (ADR-0020), imposé par le noyau.
# Budget : 4 Gio (4 096 Mio) au total, coûts hors slice compris : 3 800 Mio dans cette slice, le
# reste (~296 Mio) pour ce que le noyau compte hors d'elle (shims containerd, part AMG de dockerd
# et containerd, CLI docker et scripts, age pendant la sauvegarde, pull d'images). Constantes
# reprises dans deploy/bin/amg-common.sh et contrôlées par deploy/ci/check-budget.sh.
# Installé par l'humain AVANT le premier conteneur AMG, avec amg-prod.slice et amg-staging.slice
# (docs/EXPLOITATION.md, §9, étape 1) :
#   sudo install -o root -g root -m 644 amg.slice amg-prod.slice amg-staging.slice /etc/systemd/system/
#   sudo systemctl daemon-reload
# Docker (pilote cgroup systemd, cgroup v2) place chaque conteneur dans un scope docker-<id>.scope
# de la slice demandée : amg-prod.slice ou amg-staging.slice (enfants de celle-ci : un tiret dans
# un nom de slice marque un niveau, systemd.slice(5)), amg.slice pour les conteneurs jetables de
# l'humain. Les limites d'une slice s'appliquent à l'ensemble de ses descendants.
# Sans ce fichier, systemd créerait la slice à la volée SANS limite : deploy.sh refuse alors de
# déployer et watch.sh alerte.
# Référence : systemd.resource-control(5), systemd.slice(5).

[Unit]
Description=Conteneurs AMG (production, préproduction, ponctuels) : 3 800 Mio au plus
Before=slices.target

[Slice]
# Plafond dur : au-delà, le noyau déclenche l'OOM killer DANS la slice, jamais chez le voisin.
MemoryMax=3800M
# Freinage (récupération forcée de mémoire) avant le plafond dur.
MemoryHigh=3584M
# Pas de swap : la mémoire AMG ne peut pas déborder sur le disque partagé.
MemorySwapMax=0
MemoryZSwapMax=0
# Processeur : 3 vCPU au plus pour tout AMG, et priorité moitié de celle de system.slice (où
# tournent les services du système et les autres conteneurs) en cas de contention.
CPUQuota=300%
CPUWeight=50
# Nombre de tâches : somme des pids_limit des services (deploy/compose.yaml) avec de la marge.
TasksMax=2048
