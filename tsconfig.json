{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "dist-service",
    "node_modules",
    "playwright-report",
    "test-results",
    ".lighthouseci"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["src/components/*"],
      "@/layouts/*": ["src/layouts/*"],
      "@/lib/*": ["src/lib/*"],
      "@/config/*": ["src/config/*"],
      "@/styles/*": ["src/styles/*"],
      "@/assets/*": ["src/assets/*"],
      "@/scripts/*": ["src/scripts/*"],
      "@/*": ["src/*"]
    }
  }
}
